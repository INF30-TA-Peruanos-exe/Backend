<jasperReport name="Denuncias" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b983c2e8-d369-4b90-8574-dc7bd1a36afd">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PUCP_TA"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="publicacion_id" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT 
    d.id_reporte,
    d.motivo,
    d.fecha_reporte,
    reportante.nombreusuario AS nombre_reportante,
    admin.nombreusuario AS nombre_administrador
FROM denuncia d
JOIN usuario reportante ON d.reportante = reportante.id_usuario
LEFT JOIN administrador a ON d.id_administrador = a.id_administrador
LEFT JOIN usuario admin ON a.id_administrador = admin.id_usuario
WHERE d.autor = $P{publicacion_id} 

]]></query>
