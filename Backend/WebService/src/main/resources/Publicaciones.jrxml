	<query language="sql"><![CDATA[SELECT 
    p.idpublicacion,
    p.titulo,
    p.descripcion,
    p.fechapublicacion,
    u.nombreusuario AS autor
FROM publicacion p
JOIN usuario u ON p.id_usuario = u.id_usuario
]]></query>
