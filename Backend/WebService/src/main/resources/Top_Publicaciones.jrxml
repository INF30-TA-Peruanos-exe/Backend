	<dataset name="Valoraciones" uuid="1e6c6deb-f1a9-49ba-ab9e-6de7c2277fa9">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Adapter"/>
		<query language="SQL"><![CDATA[SELECT 
    p.titulo,
    p.idPublicacion,
    ROUND(AVG(c.valoracion), 2) AS promedio_valoracion,
    COUNT(c.id_comentario) AS total_comentarios,
    COUNT(DISTINCT c.id_usuario) AS usuarios_interactuaron
FROM publicacion p
JOIN comentario c ON p.idpublicacion = c.id_publicacion
WHERE 
    p.activo = 1
    AND c.activo = 1
    AND c.valoracion IS NOT NULL
GROUP BY p.idpublicacion
ORDER BY promedio_valoracion DESC
LIMIT 5;]]></query>
		<field name="titulo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="titulo"/>
			<property name="com.jaspersoft.studio.field.label" value="titulo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="publicacion"/>
		</field>
		<field name="idPublicacion" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="idpublicacion"/>
			<property name="com.jaspersoft.studio.field.label" value="idPublicacion"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="publicacion"/>
		</field>
		<field name="promedio_valoracion" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="promedio_valoracion"/>
			<property name="com.jaspersoft.studio.field.label" value="promedio_valoracion"/>
		</field>
		<field name="total_comentarios" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="total_comentarios"/>
			<property name="com.jaspersoft.studio.field.label" value="total_comentarios"/>
		</field>
		<field name="usuarios_interactuaron" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="usuarios_interactuaron"/>
			<property name="com.jaspersoft.studio.field.label" value="usuarios_interactuaron"/>
		</field>
		<group name="promedio_valoracion">
			<expression><![CDATA[$F{promedio_valoracion}]]></expression>
		</group>
	</dataset>
	<dataset name="Cursos" uuid="b291d477-0bc1-4398-abbf-548f6ef23ee9">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Adapter"/>
		<query language="SQL"><![CDATA[SELECT 
    c.nombre AS nombre_filtro,
    c.id_curso,
    COUNT(pc.publicacion_idpublicacion) AS total_publicaciones
FROM curso c
JOIN publicacion_curso pc ON pc.curso_id_curso = c.id_curso
JOIN publicacion p ON p.idpublicacion = pc.publicacion_idpublicacion
WHERE p.activo = 1
GROUP BY c.id_curso
ORDER BY total_publicaciones DESC
LIMIT 3;]]></query>
		<field name="id_curso" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="id_curso"/>
			<property name="com.jaspersoft.studio.field.label" value="id_curso"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="curso"/>
		</field>
		<field name="nombre_filtro" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
			<property name="com.jaspersoft.studio.field.label" value="nombre_filtro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="curso"/>
		</field>
		<field name="total_publicaciones" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="total_publicaciones"/>
			<property name="com.jaspersoft.studio.field.label" value="total_publicaciones"/>
		</field>
		<group name="total_publicaciones">
			<expression><![CDATA[$F{total_publicaciones}]]></expression>
		</group>
	</dataset>
	<dataset name="Especialidades" uuid="8fbbc7cf-00e3-41fd-9654-4346a3a77504">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Adapter"/>
		<query language="SQL"><![CDATA[SELECT 
    e.nombre AS nombre_filtro,
    e.id_especialidad,
    COUNT(pe.publicacion_idpublicacion) AS total_publicaciones
FROM especialidad e
JOIN publicacion_especialidad pe ON pe.especialidad_id_especialidad = e.id_especialidad
JOIN publicacion p ON p.idpublicacion = pe.publicacion_idpublicacion
WHERE p.activo = 1
GROUP BY e.id_especialidad
ORDER BY total_publicaciones DESC
LIMIT 3;]]></query>
