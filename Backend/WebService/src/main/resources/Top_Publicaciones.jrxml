		<query language="SQL"><![CDATA[SELECT 
    f.nombre AS nombre_filtro,
    f.id_facultad, 
    COUNT(pf.publicacion_idpublicacion) AS total_publicaciones
FROM facultad f
JOIN publicacion_facultad pf ON pf.facultad_id_facultad = f.id_facultad
JOIN publicacion p ON p.idpublicacion = pf.publicacion_idpublicacion
WHERE p.activo = 1
GROUP BY f.id_facultad
ORDER BY total_publicaciones DESC
LIMIT 3;]]></query>
