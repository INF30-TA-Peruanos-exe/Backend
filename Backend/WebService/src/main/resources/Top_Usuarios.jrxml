	<parameter name="REPORT_DATE" class="java.util.Date"/>
	<query language="SQL"><![CDATA[SELECT 
    u.id_usuario,
    u.nombre,
    u.correo,
    COUNT(DISTINCT p.idpublicacion) AS total_publicaciones,
    COUNT(DISTINCT c.id_comentario) AS total_comentarios,
    (COUNT(DISTINCT p.idpublicacion) + COUNT(DISTINCT c.id_comentario)) AS actividad_total
FROM usuario u
LEFT JOIN publicacion p ON u.id_usuario = p.id_usuario AND p.activo = 1
LEFT JOIN comentario c ON u.id_usuario = c.id_usuario AND c.activo = 1
WHERE u.activo = 1
GROUP BY u.id_usuario, u.nombre, u.correo
ORDER BY actividad_total DESC
LIMIT 5]]></query>
