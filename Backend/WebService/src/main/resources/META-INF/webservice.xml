<webservices xmlns="http://java.sun.com/xml/ns/javaee"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/webservices_1_2.xsd"
             version="1.2">
    <webservice-description>
        <webservice-description-name>PublicacionWS</webservice-description-name>
        <port-component>
            <port-component-name>PublicacionWS</port-component-name>
            <service-endpoint-interface>com.pucp.webservice.publicacion.PublicacionWS</service-endpoint-interface>
            <wsdl-port>
                <namespaceURI>http://publicacion.webservice.pucp.com/</namespaceURI>
                <localpart>PublicacionWSPort</localpart>
            </wsdl-port>
            <enable-mtom>true</enable-mtom>
        </port-component>
    </webservice-description>
</webservices>